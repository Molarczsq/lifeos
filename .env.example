POSTGRES_PASSWORD=replace-with-a-long-random-password
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000

# auto: DeepSeek uses json_object; other providers use json_schema
LLM_RESPONSE_FORMAT=auto

# 模型需支持 Function Calling；独立对话中心还使用 stream=true。
# 图片识别/图片问答要求 LLM_MODEL 支持图像输入；纯文本模型不可替代视觉模型。
# 不要将任何 LLM_* 密钥配置为 NEXT_PUBLIC_*。
